{
  "name": "Ratspeak",
  "short_name": "Ratspeak",
  "description": "End-to-end encrypted messenger for desktop, mobile, and LoRa handhelds. If the internet goes down, messages can still travel over Wi-Fi, Bluetooth, or radio.",
  "id": "/",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "display_override": [
    "browser"
  ],
  "categories": [
    "communication",
    "social",
    "utilities"
  ],
  "theme_color": "#1838ed",
  "background_color": "#0a0f2e",
  "icons": [
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/assets/seo/web-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/seo/web-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/seo/maskable-icon-512.png",
      "sizes": "512x512",
