{
  "redirects": [
    {
      "source": "/discord",
      "destination": "https://discord.gg/mvS6adBEdW",
      "statusCode": 302
    },
    {
      "source": "/telegram",
      "destination": "https://t.me/ratspeak",
      "statusCode": 302
    },
    {
      "source": "/docs",
      "destination": "https://docs.ratspeak.org/",
      "statusCode": 308
    },
    {
      "source": "/docs/getting-started/building-from-source",
      "destination": "https://docs.ratspeak.org/docs/reference/building-from-source",
      "statusCode": 308
    },
    {
      "source": "/docs/introduction/faq",
      "destination": "https://docs.ratspeak.org/docs/reference/faq",
      "statusCode": 308
    },
    {
      "source": "/docs/introduction/ratspeak-ecosystem",
      "destination": "https://docs.ratspeak.org/docs/concepts/ratspeak-ecosystem",
      "statusCode": 308
    },
    {
      "source": "/docs/introduction/what-is-ratspeak",
      "destination": "https://docs.ratspeak.org/docs/",
      "statusCode": 308
    },
    {
      "source": "/docs/products/ratdeck",
      "destination": "https://docs.ratspeak.org/docs/products/rsdeck",
      "statusCode": 308
    },
    {
      "source": "/docs/understanding/cryptography-and-protection",
      "destination": "https://docs.ratspeak.org/docs/concepts/cryptography-and-protection",
      "statusCode": 308
    },
    {
      "source": "/docs/understanding/key-concepts-and-glossary",
      "destination": "https://docs.ratspeak.org/docs/concepts/key-concepts-and-glossary",
      "statusCode": 308
    },
    {
      "source": "/docs/understanding/links-and-lxmf",
      "destination": "https://docs.ratspeak.org/docs/concepts/links-and-lxmf",
      "statusCode": 308
    },
    {
      "source": "/docs/understanding/protocol-architecture",
      "destination": "https://docs.ratspeak.org/docs/concepts/protocol-architecture",
      "statusCode": 308
    },
    {
      "source": "/docs/understanding/what-is-reticulum",
      "destination": "https://docs.ratspeak.org/docs/concepts/what-is-reticulum",
      "statusCode": 308
    },
    {
      "source": "/docs/:path*",
      "destination": "https://docs.ratspeak.org/docs/:path*",
      "statusCode": 308
    },
    {
      "source": "/poll.html",
      "destination": "/portal.html",
      "statusCode": 308
    },
    {
      "source": "/portal",
      "destination": "/portal.html",
      "statusCode": 308
    },
    {
      "source": "/about.html",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/about",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/docs.html",
      "destination": "https://docs.ratspeak.org/",
      "statusCode": 308
    },
    {
      "source": "/tasks.html",
      "destination": "/",
      "statusCode": 308
    }
  ],
  "rewrites": [
    {
      "source": "/assets/seo/og-map.png",
      "destination": "/api/og-map"
    }
  ],
  "functions": {
    "api/rsnode-beta.js": {
      "maxDuration": 30
    },
    "api/firmware.js": {
      "maxDuration": 30
    },
    "api/map-nodes.js": {
      "maxDuration": 10
    },
    "api/map-ingest.js": {
      "maxDuration": 10
    },
    "api/og-map.js": {
      "maxDuration": 10,
      "includeFiles": "scripts/data/**"
    },
    "api/proposals.js": {
      "maxDuration": 10
    },
    "api/snapshot.js": {
      "maxDuration": 10
    },
    "api/votes.js": {
      "maxDuration": 10
    },
    "api/identity.js": {
      "maxDuration": 10
    },
    "api/perks.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/lang/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
